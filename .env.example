HOST=0.0.0.0
PORT=3002
# Set TRUST_PROXY=1 only behind a proxy that appends X-Forwarded-For: IP rate limits then use the header's last hop
# (the address that proxy appended) instead of the socket address. Off by default.
TRUST_PROXY=0

# Public site origin; HTTPS in production, or http://localhost:3002 for development.
SITE_URL=

# Sign-in through auth.agora.build (the portal is its confidential OIDC client).
# Register <SITE_URL>/auth/callback, <SITE_URL>/ (post-logout) and <SITE_URL>/auth/backchannel-logout
# for the client at the IdP; see docs/platform.md#idp-registration.
AUTH_ISSUER=https://auth.agora.build
PORTAL_CLIENT_ID=portal
# At least 32 characters; the same value the IdP reads through its clients file's secretEnv.
PORTAL_CLIENT_SECRET=
# The resource IdP access tokens must name in aud for the portal's APIs.
PORTAL_API_AUDIENCE=https://api.agora.build

# Agora Console connect (separate from sign-in) through Agora SSO; the portal is a confidential client.
# Register exactly the redirect URI <SITE_URL>/connect/agora/callback for the client at Agora;
# do not reuse Astation's atem loopback client. See docs/platform.md#agora-console-connections.
AGORA_SSO_BASE_URL=https://sso2.agora.io
AGORA_SSO_CLIENT_ID=
AGORA_SSO_CLIENT_SECRET=
# Comma-separated scopes requested at authorize.
AGORA_SSO_SCOPE=basic_info,console
# The Agora CLI BFF that lists projects with their certificates (https only; empty uses the default).
AGORA_BFF_URL=https://agora-cli.agora.io
# Encrypts stored Agora Console tokens (Agora connections only). Base64-encoded 32-byte AES key,
# stored only in the server secret manager. Never change it once connections exist.
AGORA_CONSOLE_ENCRYPTION_KEY=

# PostgreSQL for durable shared user/session/credit/payment state in production.
# Local development without this uses .data/community.json (one Node process).
DATABASE_URL=

# Server-side prices for platform billing clients (such as vox): which IdP clients may reserve and settle
# credits, for which services, at how many credits per unit. Shaped like config/billing-clients.example.json.
# Unset, missing or invalid turns platform billing off.
PORTAL_BILLING_FILE=

# Whole credits charged per completed request. Zero means no credit charge.
MARKETPLACE_CHAT_CREDITS=0
MARKETPLACE_TTS_CREDITS=0

# Stripe-hosted Premium subscriptions and one-off credit pack purchases.
# Plans/credits change only after signed payment webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=
BILLING_CREDIT_PACKS_FILE=
PREMIUM_PERIOD_CREDITS=0

# OpenAI-compatible people search and LLM playground.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Speech generation. OPENAI_API_KEY can configure all three services.
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_API_KEY=

# Proactive web research uses Responses API with the web_search tool.
RADAR_BASE_URL=https://api.openai.com/v1
RADAR_MODEL=gpt-4.1-mini
RADAR_API_KEY=
RADAR_INTERVAL_HOURS=24

MODEL_REQUESTS_PER_HOUR=60

# Agora group calls. Enable App Certificate authentication in the Agora console.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600
# Agora Signaling (RTM 2.x) carries movement, presence and live messages, using AGORA_APP_ID and AGORA_APP_CERTIFICATE.
# Enable Signaling for the project in Agora Console.
# At least 32 random characters. Derives unlisted and private spaces' Signaling channel names and keys;
# keep it secret and stable. Formerly SPACE_CHANNEL_SECRET.
SPACES_SIGNALING_SECRET=
# Set to true only after Agora enables per-channel Signaling permissions for this project.
AGORA_RTM_PERMISSIONS=false
# Comma-separated account IDs (the IdP's ab… IDs: ab followed by 26 Crockford base32 characters; anything else is ignored) with platform admin rights in spaces.
PLATFORM_ADMINS=
